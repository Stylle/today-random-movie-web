# 首次初始化的一次性令牌。首次管理员创建后不再使用。
SETUP_TOKEN=replace-with-a-long-random-value

# 公网部署必须设置反向代理，并只信任明确的代理网段。
TRUSTED_PROXIES=172.16.0.0/12
PUBLIC_BASE_URL=https://movie.example.com

# 默认仅允许连接私网/回环飞牛地址。
ALLOW_PUBLIC_FNOS=false
# 设为 true 才允许 Webhook 请求私网地址。
ALLOW_PRIVATE_WEBHOOKS=false

# 应用时区；计划规则可各自覆盖。
TZ=Asia/Shanghai
SESSION_HOURS=12
REMEMBER_DAYS=30

# 可选。本机直接运行时建议只监听回环地址；容器默认监听 :8080。
# LISTEN_ADDR=127.0.0.1:8080
